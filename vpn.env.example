# The VPN for Soulseek and torrents (docker-compose.vpn.yml, Support/VPN.md).
# Copy these lines into the .env file next to docker-compose.yml and fill them in.
# .env holds secrets: never commit it, share it or paste it anywhere.

# Use the VPN file on top of docker-compose.yml, so `docker compose up -d` includes it.
# Keep exactly one COMPOSE_FILE line without a #. (On Windows use ; instead of : between the names.)
#   slskd only (works with any docker-compose.yml that has an slskd service):
COMPOSE_FILE=docker-compose.yml:docker-compose.vpn.yml
#   slskd and the qBittorrent you already run (a qbittorrent service in docker-compose.yml);
#   its settings, torrents and folders stay as they are. Needs that service, or compose stops:
# COMPOSE_FILE=docker-compose.yml:docker-compose.vpn.yml:docker-compose.vpn-qbittorrent-existing.yml
#   slskd and a NEW qBittorrent, only if docker-compose.yml has no qbittorrent service
#   (over an existing one this replaces its settings and save path):
# COMPOSE_FILE=docker-compose.yml:docker-compose.vpn.yml:docker-compose.vpn-qbittorrent.yml

# Your Proton VPN WireGuard private key: the PrivateKey line of a WireGuard
# configuration made at account.proton.me → VPN → WireGuard, with
# "NAT-PMP (Port Forwarding)" turned on. Paste the key only, not the whole file.
WIREGUARD_PRIVATE_KEY=

# Where the VPN server is. Any country with Proton P2P servers works; the
# Netherlands has many and is close to the UK (the UK has fewer P2P servers).
# Several: Netherlands,Switzerland
SERVER_COUNTRIES=Netherlands

# true: ask Proton for a forwarded port (needs Proton Plus or higher, and
#   the NAT-PMP key above). More people can reach you, so more uploads and searches work.
# false: no forwarded port (Proton Free, or while you check your plan).
#   Downloads still work; fewer people can reach you.
PORT_FORWARDING=true

# A key for Gluetun's control server, which SYNCHRO.S's privacy check and
# slskd read. Make one with:
#   docker run --rm qmcgaw/gluetun:v3.41.3 genkey
# and paste the same key into SYNCHRO.S → Setup check → Privacy.
GLUETUN_API_KEY=

# Your user and group (on a Mac: `id -u` and `id -g`), and time zone, if not set already.
# PUID=501
# PGID=20
# TZ=Europe/London
